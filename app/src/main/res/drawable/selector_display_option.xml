<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/webhtv_color_player_control_active" />
            <corners android:radius="8dp" />
            <stroke
                android:width="1dp"
                android:color="@color/webhtv_color_player_control" />
        </shape>
    </item>
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/webhtv_color_player_control_muted" />
            <corners android:radius="8dp" />
            <stroke
                android:width="1dp"
                android:color="@color/webhtv_color_player_control" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/webhtv_color_player_control_muted" />
            <corners android:radius="8dp" />
            <stroke
                android:width="1dp"
                android:color="@color/webhtv_color_player_control" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/webhtv_color_player_control_muted" />
            <corners android:radius="8dp" />
            <stroke
                android:width="1dp"
                android:color="@color/webhtv_color_player_control_muted" />
        </shape>
    </item>
</selector>
